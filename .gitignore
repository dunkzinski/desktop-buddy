# Rust build outputs
src-tauri/target/
src-tauri/target-scratch/
target/
# Legacy multi-GB prototypes
ai-avatar-bridge/
avatar-desktop/
avatar-editor/
spikes/
# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
# Local experiment logs
*.log
# Plugin build outputs (run scripts/build-plugin.sh)
plugins/*/target/
plugins/*.wasm
# ...and the session each plugin saves beside its .wasm
plugins/*.state.json
plugins/*.state.json.tmp
# Rigs the digivolution plugin generates: reproducible from (seed, archetype,
# tier) with `cargo run --example generate`, so they are runtime output, not
# source. `git add -f` one to ship a creature line on purpose.
models/digi-*/
models/digi-*/*.tmp

# Runtime state: the app rewrites these at every model switch / settings save,
# so they are machine-local, not source.
models/.state.json
watcher_rules.json.bak
# Python bytecode from the model build scripts
__pycache__/
*.pyc
